{
    "name": "dygear/prism",
    "type": "project",
    "description": "Opens a connection to Live For Speed through it's InSim protocol.",
    "homepage": "https://github.com/dygear/prism",
    "readme": "README.md",
    "license": "MIT",
    "authors": [],
    "support": {
        "issues": "https://github.com/dygear/prism/issues",
        "forum": "https://www.lfs.net/forum/312"
    },
    "suggest": {},
    "require": {
        "php": ">=8.2.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.16",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10",
        "vimeo/psalm": "^5.15"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "PRISM\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PRISM\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "bin": ["bin/prism"]
}
