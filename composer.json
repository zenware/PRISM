{
    "name": "dygear/prism",
    "type": "project",
    "homepage": "https://github.com/dygear/prism",
    "readme": "README.md",
    "license": "MIT",
    "authors": [],
    "support": {
        "issues": "https://github.com/dygear/prism/issues"
    },
    "suggest": {},
    "require": {
        "php": ">=5.3.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.16",
        "mockery/mockery": "^1.6"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "PRISM\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PRISM\\": "tests/"
        }
    },
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "bin": []
}
